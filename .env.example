# Copy to .env and fill in the values. Never commit .env.

# App client ID and client secret from the Shopify Partners dashboard
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public URL of the deployed app, for example your Vercel domain
SHOPIFY_APP_URL=

# Neon (PostgreSQL) connection string
DATABASE_URL=

# Optional. Comma-separated access scopes; the defaults are in app/shopify.server.ts.
# Leave it commented out rather than empty: an empty value replaces the defaults
# with a single blank scope.
# SCOPES=

# Optional. An extra shop domain to accept, for example a custom test domain.
# SHOP_CUSTOM_DOMAIN=
