# Copy to .env and fill in the values. Never commit .env.
# `shopify app dev` fills in SHOPIFY_API_KEY, SHOPIFY_API_SECRET and
# SHOPIFY_APP_URL itself; set them here when you run the app without the CLI.

# App client ID and client secret from the Shopify Partners dashboard
# (Apps > your app > Client credentials). The client ID is also in shopify.app.toml.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public URL of the app, without a trailing slash. Production:
# https://universal-agent-gateway.vercel.app. Local without the CLI: http://localhost:5173
SHOPIFY_APP_URL=

# PostgreSQL connection string.
# Local:  postgresql://USER:PASSWORD@localhost:5432/uag
# Neon:   copy it from the Neon dashboard (Connect); keep ?sslmode=require
# Production builds (NODE_ENV=production or on Vercel) connect through the Neon
# serverless driver, which needs a Neon database. Development uses the standard
# Prisma engine, so any PostgreSQL works.
DATABASE_URL=

# Optional. Comma-separated access scopes; the defaults are in app/shopify.server.ts
# and must match shopify.app.toml. Leave it commented out rather than empty: an
# empty value replaces the defaults with a single blank scope.
# SCOPES=read_products,read_orders

# Optional. An extra shop domain to accept, for example a custom test domain.
# SHOP_CUSTOM_DOMAIN=
